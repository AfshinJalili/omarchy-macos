#!/bin/bash
# App Exposé: pick one of the focused app's windows, on any workspace, and focus it.

set -euo pipefail

class=$(hyprctl activewindow -j | jq -r '.class // empty')
[[ -n $class ]] || exit 0

mapfile -t rows < <(hyprctl clients -j | jq -r --arg class "$class" '
  map(select(.class == $class and .mapped))
  | sort_by(.workspace.id)
  | .[]
  | "\(.title)\tworkspace \(.workspace.name) · \(.address)"')

(( ${#rows[@]} > 0 )) || exit 0

choice=$(omarchy-menu-select "$class" "${rows[@]}") || exit 0
address=${choice##* · }
[[ $address == 0x* ]] || exit 0

hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
